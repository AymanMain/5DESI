tica;" vertex="1" parent="1"><mxGeometry x="1160" y="848" width="170" height="50" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;Pro Santé Connect&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;identité des médecins&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6770;fontColor=#0B2545;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.2;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1350" y="848" width="180" height="50" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b style='font-size:13px'&gt;Région de secours — Francfort&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Réplique en lecture de la base (quelques secondes de retard)&lt;br&gt;• Copies des documents et des sauvegardes&lt;br&gt;• Peut servir les &lt;b&gt;résumés d'urgence&lt;/b&gt; en lecture seule pendant une panne&lt;br&gt;&lt;br&gt;&lt;b style='font-size:13px;color:#C0392B'&gt;Dernier recours&lt;/b&gt;&lt;br&gt;Si MedX est totalement indisponible, les urgences appellent une astreinte MedX 24h/24 qui lit le résumé à un soignant vérifié." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6F4F2;strokeColor=#0F766E;fontColor=#0B2545;fontSize=11;fontStyle=0;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;dashed=1;dashPattern=6 4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="615" width="335" height="315" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>