 parent="1"><mxGeometry x="323" y="580" width="560" height="18" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=block;startArrow=none;endFill=1;html=1;strokeColor=#6C3483;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725" y="645" as="sourcePoint"/><mxPoint x="1340" y="645" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="10 · prévient le patient (via le bus, après coup)" style="text;html=1;fontSize=11;fontColor=#6C3483;fontStyle=0;align=left;verticalAlign=bottom;spacing=0;labelBackgroundColor=#FFFFFF;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="733" y="625" width="560" height="18" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;3 ·&lt;/b&gt; connexion valide ?&lt;br&gt;redemande la MFA" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B2545;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.2;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="425" y="260" width="190" height="54" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;5 ·&lt;/b&gt; est-ce un médecin&lt;br&gt;avec un RPPS actif ?&lt;br&gt;motif renseigné ?" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="365" width="190" height="64" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Tracer d'abord, afficher ensuite :&lt;/b&gt;&lt;br&gt;pas d'entrée au journal → pas de données" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1105" y="385" width="260" height="52" as="geometry"/></mxCell><mxCell id="c36" style="endArrow=none;html=1;strokeColor=#C0392B;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="235" as="sourcePoint"/><mxPoint x="40" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="&lt; 1 seconde" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#C0392B;rotation=-90;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="8" y="360" width="28" height="140" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b style='font-size:13px;color:#C0392B'&gt;Limité&lt;/b&gt;&lt;br&gt;Résumé uniquement (pas le dossier complet), lecture seule, expire au bout de 60 minutes." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="335" height="80" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b style='font-size:13px;color:#C0392B'&gt;Traçable&lt;/b&gt;&lt;br&gt;Chaque accès est inscrit dans un journal que personne ne peut modifier ni supprimer." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="715" width="335" height="80" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b style='font-size:13px;color:#C0392B'&gt;Transparent&lt;/b&gt;&lt;br&gt;Le patient est informé de qui a consulté ses données, et quand." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="715" width="335" height="80" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b style='font-size:13px;color:#C0392B'&gt;Contrôlé&lt;/b&gt;&lt;br&gt;Un responsable conformité vérifie chaque accès d'urgence sous 72 heures." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="715" width="335" height="80" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;En cas de panne :&lt;/b&gt;  Redis indisponible → le résumé est lu dans la base  ·  région Paris indisponible → la réplique de Francfort sert les résumés et le journal est écrit dans la copie S3 de Francfort  ·  MedX totalement indisponible → une astreinte 24h/24 lit le résumé à un soignant vérifié." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B2545;fontColor=#0B2545;fontSize=11.5;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.2;spacing=6;dashed=1;dashPattern=6 4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="1385" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>