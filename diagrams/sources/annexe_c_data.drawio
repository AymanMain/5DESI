<mxfile host="MedX-generator" agent="python" version="24.0.0"><diagram id="C - Data" name="C - Data"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="MedX — Modèle de données et stockage (Annexe C)" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#0B2545;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Entités principales et leurs liens · [C] = champ chiffré par l'application, en plus du chiffrement de la base" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5B6770;fontStyle=2;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1180" height="20" as="geometry"/></mxCell><mxCell id="c3" value="Priorité (annexe 2 du sujet)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#0B2545;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1310" y="12" width="200" height="18" as="geometry"/></mxCell><mxCell id="c4" value="Haute" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.8;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1310" y="34" width="70" height="20" as="geometry"/></mxCell><mxCell id="c5" value="Moyenne" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#B9770E;fontColor=#0B2545;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.8;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1388" y="34" width="70" height="20" as="geometry"/></mxCell><mxCell id="c6" value="Basse" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#5D6D7E;fontColor=#0B2545;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.8;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1466" y="34" width="70" height="20" as="geometry"/></mxCell><mxCell id="c7" value="Entités principales" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B2545;fontColor=#0B2545;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.5;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="900" height="700" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style='background:#C0392B;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Médecin&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;id · n° RPPS&lt;br&gt;spécialité&lt;br&gt;nom, coordonnées &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="255" height="92" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style='background:#C0392B;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Patient&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;id · identifiant INS &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt;&lt;br&gt;nom, date de naissance &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt;&lt;br&gt;coordonnées, adresse &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="255" height="92" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style='background:#5D6D7E;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Pharmacie&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;id · n° FINESS&lt;br&gt;adresse · horaires&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#5D6D7E;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="635" y="120" width="255" height="76" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style='background:#B9770E;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Rendez-vous&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;id · patient · médecin&lt;br&gt;début / fin · statut&lt;br&gt;urgent ? · rang en liste d'attente&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#B9770E;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="45" y="300" width="255" height="92" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style='background:#C0392B;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Résumé d'urgence&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;id patient&lt;br&gt;groupe sanguin · allergies &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt;&lt;br&gt;traitements · pathologies &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt;&lt;br&gt;contacts d'urgence &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="255" height="108" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style='background:#C0392B;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Journal des accès&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;qui · quel patient · quand&lt;br&gt;motif (ex. urgence)&lt;br&gt;ajout seulement&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="635" y="300" width="255" height="92" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style='background:#B9770E;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Consultation&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;id · rendez-vous&lt;br&gt;début / fin&lt;br&gt;notes du médecin &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt; (versionnées)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#B9770E;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="45" y="500" width="255" height="92" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style='background:#C0392B;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Entrée du dossier médical&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;id · patient · consultation&lt;br&gt;type : diagnostic, allergie, examen…&lt;br&gt;contenu &lt;b style='color:#C0392B'&gt;[C]&lt;/b&gt; · version&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="340" y="500" width="255" height="92" as="geometry"/></mxCell><mxCell id="c16" value="&lt;div style='background:#B9770E;color:#fff;padding:5px;font-weight:bold;font-size:13px'&gt;Prescription&lt;/div&gt;&lt;div style='text-align:left;padding:5px 8px;font-size:11px;line-height:1.45'&gt;id · patient · médecin · pharmacie&lt;br&gt;médicament · posologie&lt;br&gt;statut · signature · version&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#B9770E;fontColor=#0B2545;verticalAlign=top;spacing=0;strokeWidth=1.6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="635" y="500" width="255" height="92" as="geometry"/></mxCell><mxCell id="c17" value="Aussi : &lt;b&gt;Document&lt;/b&gt; (fichier S3 + empreinte, lié à un patient), &lt;b&gt;Facture&lt;/b&gt; (consultation, montant, statut), &lt;b&gt;Notification&lt;/b&gt; (canal, reçue, lue). Les entités cliniques reprennent les noms du standard HL7 &lt;b&gt;FHIR&lt;/b&gt; (Patient, Encounter, MedicationRequest…), ce qui facilite les échanges futurs avec les hôpitaux." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#0B2545;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="45" y="680" width="860" height="90" as="geometry"/></mxCell><mxCell id="c18" value="1 → n" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#0B2545;strokeWidth=1.4;fontColor=#0B2545;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="1 → n" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#0B2545;strokeWidth=1.4;fontColor=#0B2545;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="378" y="270"/><mxPoint x="320" y="270"/><mxPoint x="320" y="330"/></Array></mxGeometry></mxCell><mxCell id="c20" value="1 → 1" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#C0392B;strokeWidth=1.4;fontColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="1 → 1" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#0B2545;strokeWidth=1.4;fontColor=#0B2545;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="1 → n" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#0B2545;strokeWidth=1.4;fontColor=#0B2545;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="1 → n" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#0B2545;strokeWidth=1.4;fontColor=#0B2545;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="600"/><mxPoint x="320" y="670"/><mxPoint x="762" y="670"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#0B2545;strokeWidth=1.4;fontColor=#0B2545;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="912" y="160"/><mxPoint x="912" y="545"/></Array></mxGeometry></mxCell><mxCell id="c25" value="tient à jour" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#C0392B;strokeWidth=1.4;fontColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c15" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Où sont les données" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#5B6770;fontColor=#5B6770;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.5;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="600" height="225" as="geometry"/></mxCell><mxCell id="c27" value="&lt;table style='border-collapse:collapse;width:570px;font-size:11px;text-align:left'&gt;&lt;tr style='background:#0B2545;color:#fff'&gt;&lt;th style='padding:5px'&gt;Stockage&lt;/th&gt;&lt;th style='padding:5px'&gt;Contenu&lt;/th&gt;&lt;th style='padding:5px'&gt;Pourquoi&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td style='padding:5px'&gt;&lt;b&gt;PostgreSQL (RDS)&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:5px'&gt;Toutes les données structurées. Un schéma par service ; un service ne lit jamais les tables d'un autre.&lt;/td&gt;&lt;td style='padding:5px'&gt;Relations, transactions, contraintes (pas de double réservation)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#EEF1F4'&gt;&lt;td style='padding:5px'&gt;&lt;b&gt;S3&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:5px'&gt;Documents, factures, journal des accès&lt;/td&gt;&lt;td style='padding:5px'&gt;Économique, très durable ; Object Lock = impossible à supprimer ou modifier&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td style='padding:5px'&gt;&lt;b&gt;Redis&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:5px'&gt;Cache + copie des résumés d'urgence&lt;/td&gt;&lt;td style='padding:5px'&gt;Lecture en quelques millisecondes&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#EEF1F4'&gt;&lt;td style='padding:5px'&gt;&lt;b&gt;Francfort&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:5px'&gt;Réplique en lecture + copies des sauvegardes&lt;/td&gt;&lt;td style='padding:5px'&gt;Survit à la perte de la région Paris&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.2;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="955" y="108" width="575" height="192" as="geometry"/></mxCell><mxCell id="c28" value="Des données sûres et exactes" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#C0392B;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.5;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="940" y="320" width="600" height="225" as="geometry"/></mxCell><mxCell id="c29" value="• &lt;b&gt;Jamais d'écrasement&lt;/b&gt; : modifier une entrée crée une nouvelle version (qui, quand, pourquoi)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Empreintes&lt;/b&gt; sur chaque fichier, vérifiées au téléchargement&lt;br&gt;&lt;br&gt;• &lt;b&gt;Sauvegardes&lt;/b&gt; quotidiennes + restauration à 35 jours, copiées à Francfort, verrouillées contre la suppression&lt;br&gt;&lt;br&gt;• &lt;b&gt;Environnements de test&lt;/b&gt; : faux patients générés (Synthea), jamais de vraies données" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#0B2545;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="960" y="352" width="565" height="185" as="geometry"/></mxCell><mxCell id="c30" value="Chiffrement" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6F4F2;strokeColor=#0F766E;fontColor=#0F766E;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.5;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="600" height="220" as="geometry"/></mxCell><mxCell id="c31" value="• &lt;b&gt;En transit&lt;/b&gt; : HTTPS (TLS 1.3) pour les utilisateurs, TLS entre services et vers les bases&lt;br&gt;&lt;br&gt;• &lt;b&gt;Au repos&lt;/b&gt; : base, fichiers et sauvegardes chiffrés avec des clés AWS KMS&lt;br&gt;&lt;br&gt;• &lt;b&gt;Champs [C]&lt;/b&gt; : chiffrés par le service lui-même — une sauvegarde volée ou un administrateur de base ne voit que des données illisibles&lt;br&gt;&lt;br&gt;• Une clé par fichier : supprimer la clé efface le fichier définitivement" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#0B2545;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="960" y="592" width="565" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>