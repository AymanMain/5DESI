<mxfile host="MedX-generator" agent="python" version="24.0.0"><diagram id="E - Security" name="E - Security"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="MedX — Sécurité : réseau, contrôle d'accès et masquage (Annexe E)" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#0B2545;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Défense en profondeur : zones réseau isolées · authentification forte · règles « qui peut voir quoi » · données masquées selon le rôle" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5B6770;fontStyle=2;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1300" height="20" as="geometry"/></mxCell><mxCell id="c3" value="Zones réseau (dans chacun des 3 datacenters)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;fontColor=#0F766E;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.5;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="470" height="470" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6F4F2;strokeColor=#0F766E;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="420" height="95" as="geometry"/></mxCell><mxCell id="c5" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="65" y="145" width="44" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;Zone publique&lt;/b&gt;&lt;br&gt;Répartiteur de charge + API Gateway&lt;br&gt;&lt;i&gt;seule partie accessible depuis Internet&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#0B2545;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="125" y="120" width="330" height="95" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF0E6;strokeColor=#ED7100;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45" y="250" width="420" height="95" as="geometry"/></mxCell><mxCell id="c8" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1"><mxGeometry x="65" y="275" width="44" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;Zone applicative privée&lt;/b&gt;&lt;br&gt;Les 8 services · pas d'accès Internet direct&lt;br&gt;appels sortants vers partenaires autorisés" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#0B2545;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="125" y="250" width="330" height="95" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FCF3FD;strokeColor=#C925D1;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.6;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45" y="380" width="420" height="95" as="geometry"/></mxCell><mxCell id="c11" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="65" y="405" width="44" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:13px'&gt;Zone de données privée&lt;/b&gt;&lt;br&gt;PostgreSQL · Redis&lt;br&gt;accessible uniquement depuis la zone applicative" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#0B2545;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="125" y="380" width="330" height="95" as="geometry"/></mxCell><mxCell id="c13" value="HTTPS" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#0B2545;strokeWidth=1.4;fontColor=#0B2545;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="TLS" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#0B2545;strokeWidth=1.4;fontColor=#0B2545;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Des règles de pare-feu (security groups) n'autorisent chaque zone à parler qu'à la suivante. S3 et KMS sont joints par des points d'accès privés AWS, jamais par Internet." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#0B2545;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="45" y="485" width="420" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Connexion et règles d'accès" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#C0392B;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.5;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="510" y="80" width="470" height="470" as="geometry"/></mxCell><mxCell id="c17" value="&lt;table style='border-collapse:collapse;width:440px;font-size:11.5px;text-align:left'&gt;&lt;tr style='background:#C0392B;color:#fff'&gt;&lt;th style='padding:5px'&gt;Rôle&lt;/th&gt;&lt;th style='padding:5px'&gt;Connexion (Keycloak)&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td style='padding:6px 5px'&gt;&lt;b&gt;Patient&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 5px'&gt;mot de passe + MFA facultative (obligatoire pour consulter le dossier)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FBEAE8'&gt;&lt;td style='padding:6px 5px'&gt;&lt;b&gt;Médecin&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 5px'&gt;MFA obligatoire · RPPS vérifié · ou Pro Santé Connect&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td style='padding:6px 5px'&gt;&lt;b&gt;Pharmacien&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 5px'&gt;MFA obligatoire · rattaché à une pharmacie&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FBEAE8'&gt;&lt;td style='padding:6px 5px'&gt;&lt;b&gt;Admin&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 5px'&gt;MFA + clé de sécurité · accès temporaire et approuvé&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.2;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="525" y="112" width="445" height="200" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;Qui peut voir le dossier d'un patient ?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Le &lt;b&gt;rôle&lt;/b&gt; dit quel type de données, la &lt;b&gt;relation&lt;/b&gt; dit de qui :&lt;br&gt;&lt;br&gt;• le patient lui-même&lt;br&gt;• un médecin qui a (ou a eu récemment) un rendez-vous avec lui&lt;br&gt;• un médecin que le patient a explicitement autorisé&lt;br&gt;• un urgentiste via l'&lt;b&gt;accès d'urgence&lt;/b&gt; (Annexe D)&lt;br&gt;&lt;br&gt;Toute autre demande est refusée — et chaque accès est tracé." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;fontColor=#0B2545;fontSize=11.5;fontStyle=0;align=left;verticalAlign=top;strokeWidth=1.4;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="525" y="290" width="440" height="245" as="geometry"/></mxCell><mxCell id="c19" value="Masquage : ce que voit chaque rôle" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#B9770E;fontColor=#B9770E;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.5;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="540" height="470" as="geometry"/></mxCell><mxCell id="c20" value="&lt;table style='border-collapse:collapse;width:510px;font-size:11px;text-align:center'&gt;&lt;tr style='background:#B9770E;color:#fff'&gt;&lt;th style='padding:5px;text-align:left'&gt;Donnée&lt;/th&gt;&lt;th style='padding:5px'&gt;Patient&lt;/th&gt;&lt;th style='padding:5px'&gt;Médecin&lt;br&gt;traitant&lt;/th&gt;&lt;th style='padding:5px'&gt;Urgentiste&lt;/th&gt;&lt;th style='padding:5px'&gt;Pharma-&lt;br&gt;cien&lt;/th&gt;&lt;th style='padding:5px'&gt;Support&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 5px;text-align:left;background:#fff'&gt;&lt;b&gt;Nom, date de naissance&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FAE5D3;border:1px solid #fff'&gt;Nom + année&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FCF3CF;border:1px solid #fff'&gt;Masqué&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 5px;text-align:left;background:#fff'&gt;&lt;b&gt;Identifiant INS&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#F2F3F4;border:1px solid #fff'&gt;—&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FCF3CF;border:1px solid #fff'&gt;•••• 1234&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 5px;text-align:left;background:#fff'&gt;&lt;b&gt;Diagnostics, notes&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FAE5D3;border:1px solid #fff'&gt;Résumé&lt;/td&gt;&lt;td style='padding:6px 3px;background:#F2F3F4;border:1px solid #fff'&gt;—&lt;/td&gt;&lt;td style='padding:6px 3px;background:#F2F3F4;border:1px solid #fff'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 5px;text-align:left;background:#fff'&gt;&lt;b&gt;Allergies, traitements&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FAE5D3;border:1px solid #fff'&gt;Ordonnance&lt;/td&gt;&lt;td style='padding:6px 3px;background:#F2F3F4;border:1px solid #fff'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 5px;text-align:left;background:#fff'&gt;&lt;b&gt;Prescriptions&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FAE5D3;border:1px solid #fff'&gt;Résumé&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FAE5D3;border:1px solid #fff'&gt;Sa pharmacie&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FCF3CF;border:1px solid #fff'&gt;Statut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 5px;text-align:left;background:#fff'&gt;&lt;b&gt;Paiements&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 3px;background:#D5F5E3;border:1px solid #fff'&gt;Complet&lt;/td&gt;&lt;td style='padding:6px 3px;background:#F2F3F4;border:1px solid #fff'&gt;—&lt;/td&gt;&lt;td style='padding:6px 3px;background:#F2F3F4;border:1px solid #fff'&gt;—&lt;/td&gt;&lt;td style='padding:6px 3px;background:#F2F3F4;border:1px solid #fff'&gt;—&lt;/td&gt;&lt;td style='padding:6px 3px;background:#FCF3CF;border:1px solid #fff'&gt;4 derniers chiffres&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0B2545;fontSize=11;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.2;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1015" y="112" width="515" height="300" as="geometry"/></mxCell><mxCell id="c21" value="Le masquage est appliqué par le service avant que les données ne sortent : aucune application ne peut le contourner.&lt;br&gt;&lt;br&gt;Un médecin peut différer l'affichage d'une note au patient jusqu'à l'annonce en personne d'un diagnostic difficile." style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#0B2545;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1015" y="345" width="510" height="150" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style='font-size:13px'&gt;Conformité&lt;/b&gt;&lt;br&gt;&lt;b&gt;RGPD&lt;/b&gt; : données de santé = catégorie particulière — minimisation, chiffrement, accès et export par le patient, analyse d'impact (AIPD) avant lancement  ·  &lt;b&gt;HDS&lt;/b&gt; : hébergement uniquement sur infrastructure certifiée (AWS Paris / Francfort)  ·  &lt;b&gt;Conservation&lt;/b&gt; : dossiers médicaux conservés 20 ans  ·  &lt;b&gt;Paiements&lt;/b&gt; : données de carte gérées uniquement par Stripe" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#5B6770;fontColor=#0B2545;fontSize=11.5;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.2;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1520" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>